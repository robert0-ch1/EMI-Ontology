<?xml version="1.0"?>
<rdf:RDF xmlns="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#"
     xml:base="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology">
        <rdfs:comment xml:lang="en">An ontology for classifying hardware synthesizers, samplers, and drum machines.</rdfs:comment>
        <rdfs:label xml:lang="en">Electronic Music Instrument Ontology</rdfs:label>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#dbpediaRef -->

    <owl:AnnotationProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#dbpediaRef">
        <rdfs:comment xml:lang="en">Link to the corresponding DBpedia resource (stored as string to avoid being treated as a separate entity).</rdfs:comment>
        <rdfs:label xml:lang="en">DBpedia reference</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#wikipediaRef -->

    <owl:AnnotationProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#wikipediaRef">
        <rdfs:comment xml:lang="en">Link to the corresponding Wikipedia article (stored as string to avoid being treated as a separate entity).</rdfs:comment>
        <rdfs:label xml:lang="en">Wikipedia reference</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#seeAlso -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#basedIn -->

    <owl:ObjectProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#basedIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Manufacturer"/>
        <rdfs:range rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Country"/>
        <rdfs:comment xml:lang="en">Links a manufacturer to its country of origin.</rdfs:comment>
        <rdfs:label xml:lang="en">based in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#contemporaryOf -->

    <owl:ObjectProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#contemporaryOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:range rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:comment xml:lang="en">Two instruments released in the same year. Symmetric: A contemporaryOf B implies B contemporaryOf A. Populated via SWRL rule (TODO: add the rule in Protégé Rules tab).</rdfs:comment>
        <rdfs:label xml:lang="en">contemporary of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasDecade -->

    <owl:ObjectProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasDecade">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:range rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Decade"/>
        <rdfs:comment xml:lang="en">Links an instrument to the decade in which it was released. Functional: one decade per instrument. Populated by SWRL rules; cannot be expressed in pure OWL2.</rdfs:comment>
        <rdfs:label xml:lang="en">has decade</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasManufacturer -->

    <owl:ObjectProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasManufacturer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:range rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Manufacturer"/>
        <rdfs:comment xml:lang="en">Links a hardware instrument to its manufacturer. Functional: exactly one manufacturer per instrument.</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSoundGeneration -->

    <owl:ObjectProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSoundGeneration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:range rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#SoundGeneration"/>
        <rdfs:comment xml:lang="en">Links an instrument to its sound-generation paradigm (Analog, Digital, or Hybrid).</rdfs:comment>
        <rdfs:label xml:lang="en">has sound generation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSynthesisMethod -->

    <owl:ObjectProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSynthesisMethod">
        <rdfs:domain rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:range rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#SynthesisMethod"/>
        <rdfs:comment xml:lang="en">Links an instrument to the synthesis method it uses (e.g. Subtractive, FM, Sample-based).</rdfs:comment>
        <rdfs:label xml:lang="en">has synthesis method</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#originCountry -->

    <owl:ObjectProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#originCountry">
        <rdfs:domain rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:range rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Country"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasManufacturer"/>
            <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#basedIn"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="en">Links a hardware instrument to the country in which its manufacturer is based. Inferred via the property chain hasManufacturer ∘ basedIn. Note: this represents the manufacturer&apos;s country of origin, not necessarily the physical assembly location of the device.</rdfs:comment>
        <rdfs:label xml:lang="en">origin country</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasModelName -->

    <owl:DatatypeProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasModelName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The model designation of the instrument as a literal string.</rdfs:comment>
        <rdfs:label xml:lang="en">model name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#polyphony -->

    <owl:DatatypeProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#polyphony">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Synthesizer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The maximum number of simultaneous voices for a synthesizer. Only meaningful for the Synthesizer class.</rdfs:comment>
        <rdfs:label xml:lang="en">polyphony</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#yearOfRelease -->

    <owl:DatatypeProperty rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#yearOfRelease">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The year an instrument was first released. Functional: one canonical year per instrument.</rdfs:comment>
        <rdfs:label xml:lang="en">year of release</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#AnalogDrumMachine -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#AnalogDrumMachine">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#DrumMachine"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSoundGeneration"/>
                        <owl:hasValue rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Analog"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Analog Drum Machine</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#AnalogInstrument -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#AnalogInstrument">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSoundGeneration"/>
                        <owl:hasValue rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Analog"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Any hardware instrument that uses analog sound generation.</rdfs:comment>
        <rdfs:label xml:lang="en">Analog Instrument</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#AnalogSynth -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#AnalogSynth">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Synthesizer"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSoundGeneration"/>
                        <owl:hasValue rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Analog"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Analog Synthesizer</rdfs:label>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q3268757"/>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Country -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Country">
        <rdfs:comment xml:lang="en">A nation in which a manufacturer is based.</rdfs:comment>
        <rdfs:label xml:lang="en">Country</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Decade -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Decade">
        <rdfs:comment xml:lang="en">A 10-year time period.</rdfs:comment>
        <rdfs:label xml:lang="en">Decade</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#DigitalDrumMachine -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#DigitalDrumMachine">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#DrumMachine"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSoundGeneration"/>
                        <owl:hasValue rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Digital"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Digital Drum Machine</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#DigitalInstrument -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#DigitalInstrument">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSoundGeneration"/>
                        <owl:hasValue rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Digital"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Any hardware instrument that uses digital sound generation.</rdfs:comment>
        <rdfs:label xml:lang="en">Digital Instrument</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#DigitalSynth -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#DigitalSynth">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Synthesizer"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSoundGeneration"/>
                        <owl:hasValue rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Digital"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Digital Synthesizer</rdfs:label>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q5276177"/>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#DrumMachine -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#DrumMachine">
        <rdfs:subClassOf rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:comment xml:lang="en">An electronic instrument that generates drum and percussion sounds, typically with built-in sequencing.</rdfs:comment>
        <rdfs:label xml:lang="en">Drum Machine</rdfs:label>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q831698"/>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument">
        <rdfs:comment xml:lang="en">An electronic musical instrument implemented in hardware (not software). Top concept of the ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Hardware Instrument</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HybridDrumMachine -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HybridDrumMachine">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#DrumMachine"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSoundGeneration"/>
                        <owl:hasValue rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Hybrid"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Hybrid Drum Machine</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HybridInstrument -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HybridInstrument">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSoundGeneration"/>
                        <owl:hasValue rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Hybrid"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Any hardware instrument that uses hybrid (analog + digital) sound generation.</rdfs:comment>
        <rdfs:label xml:lang="en">Hybrid Instrument</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HybridSynth -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HybridSynth">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Synthesizer"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#hasSoundGeneration"/>
                        <owl:hasValue rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Hybrid"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Hybrid Synthesizer</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.wikidata.org/wiki/Q25335322"/>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Manufacturer -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Manufacturer">
        <rdfs:comment xml:lang="en">A company that manufactures hardware musical instruments.</rdfs:comment>
        <rdfs:label xml:lang="en">Manufacturer</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#MonophonicSynth -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#MonophonicSynth">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Synthesizer"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#polyphony"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">A synthesizer capable of playing only one note at a time.</rdfs:comment>
        <rdfs:label xml:lang="en">Monophonic Synthesizer</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#PolyphonicSynth -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#PolyphonicSynth">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Synthesizer"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#polyphony"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">A synthesizer capable of playing two or more notes simultaneously.</rdfs:comment>
        <rdfs:label xml:lang="en">Polyphonic Synthesizer</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Sampler -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Sampler">
        <rdfs:subClassOf rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:comment xml:lang="en">An electronic instrument that plays back recorded sound samples, typically pitched and looped.</rdfs:comment>
        <rdfs:label xml:lang="en">Sampler</rdfs:label>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q320002"/>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#SoundGeneration -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#SoundGeneration">
        <rdfs:comment xml:lang="en">The fundamental sound-generation approach: Analog, Digital, or Hybrid.</rdfs:comment>
        <rdfs:label xml:lang="en">Sound Generation Paradigm</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#SynthesisMethod -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#SynthesisMethod">
        <rdfs:comment xml:lang="en">A technique for generating or shaping electronic sound.</rdfs:comment>
        <rdfs:label xml:lang="en">Synthesis Method</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Synthesizer -->

    <owl:Class rdf:about="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#Synthesizer">
        <rdfs:subClassOf rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
        <rdfs:comment xml:lang="en">An electronic instrument that generates audio signals through synthesis methods.</rdfs:comment>
        <rdfs:label xml:lang="en">Synthesizer</rdfs:label>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q163829"/>
    </owl:Class>
    


