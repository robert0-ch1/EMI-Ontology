    <rdfs:range rdf:resource="https://github.com/robert0-ch1/EMI-Ontology/electronic_music_instrument_ontology#HardwareInstrument"/>
    <rdfs:comment xml:lang="en">Two instruments released in the same year. Symmetric: A contemporaryOf B implies B contemporaryOf A. Populated via SWRL rule (TODO: add the rule in Protégé Rules tab).</rdfs:comment>
    <rdfs:label xml:lang="en">contemporary of</rdfs:label>
  </rdf:Description>
